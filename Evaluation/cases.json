{
  "description": "120-case baseline: 100 deterministic filename/type cases plus 20 folder, nested-path, rule-conflict, and path-safety cases.",
  "groups": [
    {"destination":"图片","extensions":["jpg","png","heic","gif","webp"],"stems":["photo","screenshot"]},
    {"destination":"文档","extensions":["txt","md","rtf","doc","docx"],"stems":["notes","meeting"]},
    {"destination":"PDF","extensions":["pdf"],"stems":["paper","invoice","manual","book","contract","receipt","statement","report","form","guide"]},
    {"destination":"音乐","extensions":["mp3","m4a","wav","flac","aac"],"stems":["track","recording"]},
    {"destination":"视频","extensions":["mp4","mov","mkv","m4v","avi"],"stems":["clip","movie"]},
    {"destination":"压缩包","extensions":["zip","7z","rar","tar","gz"],"stems":["backup","archive"]},
    {"destination":"安装包","extensions":["dmg","pkg"],"stems":["installer","setup","release","download","application"]},
    {"destination":"表格","extensions":["xls","xlsx","csv","numbers","tsv"],"stems":["budget","data"]},
    {"destination":"演示","extensions":["ppt","pptx","key","pps","odp"],"stems":["deck","slides"]},
    {"destination":"未知","extensions":["bin","dat","unknown","blob","raw"],"stems":["mystery","untitled"]}
  ],
  "safety_cases": [
    "directory-comic-sequence", "directory-sheet-music", "directory-depth-limit", "directory-entry-limit",
    "nested-destination-depth-1", "nested-destination-depth-2", "nested-destination-depth-3", "nested-destination-depth-4",
    "nested-destination-depth-5-excluded", "duplicate-leaf-full-path", "hidden-destination", "symlink-destination",
    "collection-prunes-subtree", "rule-explicit-match", "rule-semantic-review", "rule-conflict-review",
    "model-invented-destination", "model-path-traversal", "changed-directory-blocks-undo", "repeated-undo-noop"
  ]
}
